<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="28dp">

        <!-- ===================== HEADING ===================== -->
        <TextView
            android:id="@+id/textHeading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/heading"
            android:textColor="@color/textPrimary"
            android:textSize="22sp"
            android:textStyle="bold"
            android:letterSpacing="0.03"
            android:layout_marginBottom="18dp" />

        <!-- ===================== SELECT DEVICE ===================== -->
        <Button
            android:id="@+id/buttonSelectDevice"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_button_outline"
            android:text="@string/select_device"
            android:textAllCaps="false"
            android:textColor="@color/colorPrimary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:elevation="0dp" />

        <!-- ===================== CONNECTION STATUS ===================== -->
        <TextView
            android:id="@+id/textStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="22dp"
            android:gravity="center"
            android:text="@string/status_disconnected"
            android:textColor="@color/statusDisconnected"
            android:textSize="17sp"
            android:textStyle="bold" />

        <!-- ===================== FALL ALERT BANNER ===================== -->
        <LinearLayout
            android:id="@+id/bannerFallAlert"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            android:orientation="vertical"
            android:background="@color/alertBannerBackground"
            android:padding="14dp"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/alert_fall_title"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/buttonDismissAlert"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_gravity="end"
                android:layout_marginTop="8dp"
                android:background="@android:color/transparent"
                android:text="@string/alert_fall_dismiss"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:minWidth="0dp"
                android:elevation="0dp" />
        </LinearLayout>

        <!-- ===================== D-PAD ===================== -->
        <Button
            android:id="@+id/buttonForward"
            android:layout_width="190dp"
            android:layout_height="68dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_button_primary"
            android:enabled="false"
            android:text="@string/btn_forward"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:elevation="0dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/buttonLeft"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_button_primary"
                android:enabled="false"
                android:text="@string/btn_left"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                android:elevation="0dp" />

            <Button
                android:id="@+id/buttonStop"
                android:layout_width="92dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_button_stop"
                android:enabled="false"
                android:text="@string/btn_stop"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:elevation="0dp" />

            <Button
                android:id="@+id/buttonRight"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_button_primary"
                android:enabled="false"
                android:text="@string/btn_right"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                android:elevation="0dp" />
        </LinearLayout>

        <Button
            android:id="@+id/buttonBackward"
            android:layout_width="190dp"
            android:layout_height="68dp"
            android:layout_marginTop="10dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_button_primary"
            android:enabled="false"
            android:text="@string/btn_backward"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:elevation="0dp" />

        <!-- ===================== VOICE CONTROL ===================== -->
        <Button
            android:id="@+id/buttonVoice"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_button_voice"
            android:enabled="false"
            android:text="@string/btn_voice_locked"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:elevation="0dp" />

        <!-- ===================== CURRENT COMMAND / DEVICE ===================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_current_command"
                android:textColor="@color/textSecondary"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/textCurrentCommand"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:gravity="end"
                android:text="@string/label_none"
                android:textColor="@color/textPrimary"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_bluetooth_device"
                android:textColor="@color/textSecondary"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/textBluetoothDevice"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:gravity="end"
                android:text="@string/label_none"
                android:textColor="@color/textPrimary"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ===================== GPS LOCATION (from ESP32) ===================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:background="@drawable/bg_gps_card"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/gps_title"
                android:textColor="@color/textPrimary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textGpsLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/label_none"
                android:textColor="@color/textPrimary"
                android:textSize="15sp" />

            <Button
                android:id="@+id/buttonViewOnMap"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_button_outline"
                android:enabled="false"
                android:text="@string/gps_view_on_map"
                android:textAllCaps="false"
                android:textColor="@color/colorPrimary"
                android:textSize="13sp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:minWidth="0dp"
                android:elevation="0dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/gps_note"
                android:textColor="@color/textSecondary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- ===================== DEBUG / STATUS PANEL ===================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/debug_title"
                android:textColor="@color/textPrimary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/textDebugBluetooth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/textSecondary"
                android:textSize="13sp"
                tools:text="Bluetooth: Disconnected" />

            <TextView
                android:id="@+id/textDebugDevice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/textSecondary"
                android:textSize="13sp"
                android:layout_marginTop="2dp"
                tools:text="Device: —" />

            <TextView
                android:id="@+id/textDebugLastCommand"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/textSecondary"
                android:textSize="13sp"
                android:layout_marginTop="2dp"
                tools:text="Last command: —" />

            <TextView
                android:id="@+id/textDebugLastVoice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/textSecondary"
                android:textSize="13sp"
                android:layout_marginTop="2dp"
                tools:text="Last recognized voice: —" />

            <ScrollView
                android:id="@+id/scrollLog"
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_log"
                android:padding="8dp"
                android:scrollbars="vertical">

                <TextView
                    android:id="@+id/textLog"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textColor="@color/logText"
                    android:textSize="11sp"
                    android:textIsSelectable="true" />
            </ScrollView>

        </LinearLayout>

    </LinearLayout>
</ScrollView>
